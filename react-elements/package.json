{
  "name": "@serafort/react-elements",
  "version": "0.1.0",
  "type": "module",
  "description": "Clerk-style drop-in styled React components (<SignIn/>, <LoginBox/>, <UserProfile/>) for Serafort authentication, built on @serafort/react-sdk + MUI v7.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "comment:publishConfig": "See @serafort/react-sdk/package.json for why publishConfig points at dist/ — same rationale applies here.",
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "type-check": "tsc --noEmit",
    "build": "tsc",
    "dev": "tsc -w",
    "format": "prettier --write .",
    "test": "vitest run --passWithNoTests",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.6",
    "@mui/material": "^7.3.6",
    "@serafort/core": "^0.1.0",
    "@serafort/react-sdk": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "typescript": "^6.0.0 || ^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.4",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.7",
    "prettier": "^3.7.4",
    "typescript7": "npm:typescript@^7.0.2",
    "vitest": "^4.0.16"
  }
}
